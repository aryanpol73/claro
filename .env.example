# Claro Environment Configuration

# 1. Groq API Key (Fast, high-rate-limit LLM for academic Q&A, synthesis, and summarization)
# Get a key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Optional: Google Gemini API Key (if using Gemini models or embeddings)
# GOOGLE_API_KEY=your_google_api_key_here

# 2. Pinecone API Key (Required for vector storage and semantic retrieval)
# Get a key from: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here

# Pinecone Index Name (defaults to 'academic-files-rag')
PINECONE_INDEX_NAME=academic-files-rag

# 3. Model Configuration
# Groq LLMs: openai/gpt-oss-20b, qwen/qwen3.8-27b, openai/gpt-oss-120b
LLM_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
TEMPERATURE=0.0
TOP_K_RESULTS=4

# 4. LangSmith Observability (Optional)
# LANGSMITH_API_KEY=your_langsmith_key_here
# LANGSMITH_PROJECT=Academic-Files-Rag
